# Python API location (server-side Next.js route only)
REA_API_BASE_URL=http://127.0.0.1:8000

# Required before exposing UI-triggered sync in a production deployment.
REA_ENABLE_UI_SYNC=false

# Must match REA_SYNC_ADMIN_TOKEN configured for the Python API.
REA_SYNC_ADMIN_TOKEN=

# Gmail credentials (for automated email crawling & report delivery)
GMAIL_USERNAME=
GMAIL_PASSWORD=
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REDIRECT_URI=http://localhost:3004/api/gmail/callback
# Comma-separated; only these senders may cause CSV processing or receive a reply.
GMAIL_ALLOWED_SENDERS=your.name@gmail.com

# Remote Chrome / Browserless.io WebSocket (for Vercel Playwright automation)
BROWSERLESS_API_KEY=
BROWSERLESS_WS_ENDPOINT=wss://chrome.browserless.io?token=
