# Copy to .env and populate through an approved secret-management process.
TEAM_APP_AES_KEY=
TEAM_APP_AES_IV=

# REA Partner Platform Listing Export API (server-side only)
# Apply at https://partner.realestate.com.au/ and request
# listing:listings:export for customer-authorised agencies.
REA_PARTNER_CLIENT_ID=
REA_PARTNER_CLIENT_SECRET=
# Optional default six-character REA agency/customer identifier.
REA_PARTNER_AGENCY_ID=
# Optional protection for the sync endpoint. Set the same value for the API and
# Next.js server; it is never sent to the browser.
REA_SYNC_ADMIN_TOKEN=

# ---------------------------------------------------------------------------
# Residential proxy configuration (for bypassing Cloudflare / anti-bot on REA)
# ---------------------------------------------------------------------------
# Comma-separated list of proxy URLs. Standard format: http://user:pass@host:port
# Supports Bright Data, Oxylabs, SmartProxy, SOAX, or bare ip:port entries.
# Examples:
#   Bright Data:  http://brd-customer-XXXXX-zone-residential:PASSWORD@zproxy.lum-superproxy.io:22225
#   Oxylabs:      http://user:pass@pr.oxylabs.io:7777
#   SmartProxy:   http://user:pass@gate.smartproxy.com:7000
#   SOAX:         http://user:pass@proxy.soax.com:5000
#   Bare IP list: http://1.2.3.4:8080,http://5.6.7.8:3128
REA_PROXY_URLS=

# true  = pick a fresh random proxy for every fetch attempt (recommended)
# false = round-robin through the pool in order
REA_PROXY_ROTATE=true

# Number of different proxies to try before giving up on a blocked request
REA_PROXY_MAX_RETRIES=3

# Per-request timeout in seconds when using a proxy (proxies add latency)
REA_PROXY_TIMEOUT_SECONDS=60

# CoreLogic / Cotality OAuth credentials (server-side only)
CORELOGIC_APP_DISPLAY_NAME=
CORELOGIC_APP_NAME=
CORELOGIC_CLIENT_ID=
CORELOGIC_CLIENT_SECRET=

# Service endpoints extracted from https://developer.corelogic.asia/apis
CORELOGIC_SANDBOX_BASE_URL=https://api-sbox.corelogic.asia
CORELOGIC_UAT_BASE_URL=https://api-uat.corelogic.asia
COTALITY_ENTERPRISE_UAT_BASE_URL=https://api-uat.cotality.com.au/enriched-property
CORELOGIC_COMMERCIAL_BASE_URL=https://api-sbox.corelogic.asia/commercial-api/au/v1
CORELOGIC_CONSTRUCTION_BASE_URL=https://api-sbox.corelogic.asia/construction-api
CORELOGIC_CONTENT_BASE_URL=https://api-sbox.corelogic.asia/content
CORELOGIC_INSURANCE_BASE_URL=https://api-sbox.corelogic.asia/sumsure/au
CORELOGIC_PSX_UAT_BASE_URL=https://psx-uat.corelogic.asia
CORELOGIC_API_CATALOG_PATH=config/corelogic-api-catalog.json

# ---------------------------------------------------------------------------
# Gmail credentials (for automated email crawling & report delivery)
# ---------------------------------------------------------------------------
GMAIL_USERNAME=
GMAIL_PASSWORD=
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REDIRECT_URI=http://localhost:3004/api/gmail/oauth/callback
GMAIL_TOKEN_ENCRYPTION_KEY=
# Comma-separated list of approved email addresses permitted to trigger jobs / receive reports
GMAIL_ALLOWED_SENDERS=

# ---------------------------------------------------------------------------
# Remote Chrome / Browserless.io WebSocket (for Vercel Playwright automation)
# ---------------------------------------------------------------------------
BROWSERLESS_API_KEY=
BROWSERLESS_WS_ENDPOINT=wss://production-sfo.browserless.io?token=

# Durable checkpoint/job database (Neon pooled connection string)
DATABASE_URL=postgresql://USER:PASSWORD@YOUR-POOLER-HOST/neondb?sslmode=require

# Render deployment API (server-side only)
RENDER_API_KEY=

# URL of the deployed Parcel Atlas app (used by cotality:batch for report generation)
# Set to http://localhost:3004 for local development
PARCEL_ATLAS_BASE_URL=https://australian-property.vercel.app

# ---------------------------------------------------------------------------
# GitHub Actions workflow dispatch (Vercel server-side only)
# ---------------------------------------------------------------------------
# The Auto-pilot button asks GitHub to run the Gmail worker. Only the Vercel
# server route uses these; never expose them with a NEXT_PUBLIC_ prefix.
#
# The token must be a fine-grained PAT scoped to this repository alone, with the
# minimum permission needed to dispatch a workflow (Actions: read and write).
GITHUB_WORKFLOW_DISPATCH_TOKEN=
GITHUB_REPOSITORY_OWNER=a1official
GITHUB_REPOSITORY_NAME=Australian-property
GITHUB_GMAIL_WORKFLOW_FILE=gmail-report-pipeline.yml
# Optional. Defaults to main; the branch whose workflow definition is dispatched.
GITHUB_WORKFLOW_REF=main
